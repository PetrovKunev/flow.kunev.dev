@model FlowKunevDev.Web.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Смяна на парола";
}

<h1 class="text-primary">@ViewData["Title"]</h1>
<p class="text-muted mb-4">Променете паролата за достъп до вашия профил</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-3">
        <partial name="_AccountSidebar" />
    </div>
    <div class="col-md-9">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-warning">
                    <div class="card-header">
                        <h4 class="card-title mb-0">
                            <i class="fas fa-key me-2"></i>Промяна на парола
                        </h4>
                    </div>
                    <div class="card-body">
                        <form asp-action="ChangePassword" asp-controller="Account" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="OldPassword" class="form-control" autocomplete="current-password" placeholder="Текуща парола" />
                                <label asp-for="OldPassword"></label>
                                <span asp-validation-for="OldPassword" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" placeholder="Нова парола" />
                                <label asp-for="NewPassword"></label>
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Потвърди новата парола" />
                                <label asp-for="ConfirmPassword"></label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="fas fa-save me-2"></i>Актуализирай паролата
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-info">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-shield-alt me-2"></i>Изисквания за парола
                        </h5>
                    </div>
                    <div class="card-body">
                        <ul class="small mb-0">
                            <li>Поне 6 символа</li>
                            <li>Поне една малка буква</li>
                            <li>Поне една цифра</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
