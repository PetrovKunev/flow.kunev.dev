@model FlowKunevDev.Web.ViewModels.Account.ProfileViewModel
@{
    ViewData["Title"] = "Управление на профила";
}

<h1 class="text-primary">@ViewData["Title"]</h1>
<p class="text-muted mb-4">Променете настройките на вашия профил</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-3">
        <partial name="_AccountSidebar" />
    </div>
    <div class="col-md-9">
        <div class="card border-primary">
            <div class="card-header">
                <h4 class="card-title mb-0">
                    <i class="fas fa-user me-2"></i>Профил
                </h4>
            </div>
            <div class="card-body">
                <form asp-action="Profile" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="UserName" class="form-control" placeholder="Потребителско име" />
                        <label asp-for="UserName"></label>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="Имейл" />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Телефон" />
                        <label asp-for="PhoneNumber"></label>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save me-2"></i>Запази
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
