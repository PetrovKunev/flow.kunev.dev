@model FlowKunevDev.Web.ViewModels.Account.SavingsSettingsViewModel
@{
    ViewData["Title"] = "Цел за спестяване";
}

<h1 class="text-primary">@ViewData["Title"]</h1>
<p class="text-muted mb-4">
    Задайте сметка за приходи, сметка за спестявания и какъв процент от месечния приход искате да отделяте.
    Виджетът на таблото ще следи прогреса всеки месец.
</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-3">
        <partial name="_AccountSidebar" />
    </div>
    <div class="col-md-9">
        <div class="col-lg-9">
            <div class="card border-primary">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-piggy-bank me-2"></i>Настройки за спестяване
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="SavingsSettings" asp-controller="Account" method="post">
                        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="SalaryAccountId" class="form-label"></label>
                            <select asp-for="SalaryAccountId" asp-items="Model.AccountOptions" class="form-select">
                                <option value="">— Изберете сметка —</option>
                            </select>
                            <div class="form-text">Сметка, в която постъпват приходите ви (заплата).</div>
                            <span asp-validation-for="SalaryAccountId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SavingsAccountId" class="form-label"></label>
                            <select asp-for="SavingsAccountId" asp-items="Model.AccountOptions" class="form-select">
                                <option value="">— Изберете сметка —</option>
                            </select>
                            <div class="form-text">Сметка, в която прехвърляте спестяванията.</div>
                            <span asp-validation-for="SavingsAccountId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MonthlySavingsPercent" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="MonthlySavingsPercent" type="number" step="0.5" min="0" max="100" class="form-control" placeholder="напр. 10" />
                                <span class="input-group-text">%</span>
                            </div>
                            <div class="form-text">Каква част от реално получения месечен приход искате да отделите.</div>
                            <span asp-validation-for="MonthlySavingsPercent" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ExpectedMonthlyIncome" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ExpectedMonthlyIncome" type="number" step="0.01" min="0" class="form-control" placeholder="напр. 4500" />
                                <span class="input-group-text">€</span>
                            </div>
                            <div class="form-text">
                                Базова стойност за прогноза в началото на месеца, преди заплатата да е дошла.
                                Реалната цел се изчислява спрямо реалния приход, не спрямо очаквания.
                            </div>
                            <span asp-validation-for="ExpectedMonthlyIncome" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save me-2"></i>Запази
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
